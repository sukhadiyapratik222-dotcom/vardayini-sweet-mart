# ============================================================
# VARDAYINI SWEET MART - ENVIRONMENT CONFIGURATION (.env.example)
# ============================================================

# Database Credentials
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=vardayini_sweet_mart

# MySQL Prisma Connection String
DATABASE_URL="mysql://root:@localhost:3306/vardayini_sweet_mart"

# Server Configuration
PORT=4000
NODE_ENV=production

# JWT Secret Key
JWT_SECRET=vardayini_super_secret_jwt_key_2026_production

# Razorpay Online Payment Gateway (Optional)
RAZORPAY_KEY_ID=rzp_test_1234567890
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here

# Public Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:4000/api
