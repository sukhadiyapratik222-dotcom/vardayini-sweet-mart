generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum ProductTag {
  best_seller
  new_arrival
  premium
  combo
  none
}

model User {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String     @unique
  phone        String?    @unique
  passwordHash String     @map("password_hash")
  createdAt    DateTime   @default(now()) @map("created_at")
  role         String     @default("customer")
  isAdmin      Boolean    @default(false) @map("is_admin")
  addresses    Address[]
  orders       Order[]
  carts        Cart[]
  reviews      Review[]
  wishlists    Wishlist[]

  @@map("users")
}

model Admin {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String   @unique
  phone        String?  @unique
  passwordHash String   @map("password_hash")
  role         String   @default("admin")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("admins")
}

model Address {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  user      User    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId    String  @db.ObjectId
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  isDefault Boolean @default(false)
}

model Category {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  parent    Category?  @relation("CategoryChildren", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parentId  String?    @map("parent_id") @db.ObjectId
  name      String
  slug      String     @unique
  sortOrder Int        @default(0) @map("sort_order")
  children  Category[] @relation("CategoryChildren")
  products  Product[]

  @@map("categories")
}

model Product {
  id            String           @id @default(auto()) @map("_id") @db.ObjectId
  category      Category         @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  categoryId    String           @map("category_id") @db.ObjectId
  name          String
  slug          String           @unique
  description   String?
  ratingAvg     Float            @default(5.0) @map("rating_avg")
  ratingCount   Int              @default(0) @map("rating_count")
  tag           ProductTag       @default(none)
  isActive      Boolean          @default(true) @map("is_active")
  createdAt     DateTime         @default(now()) @map("created_at")
  productImages ProductImage[]
  variants      ProductVariant[]
  reviews       Review[]
  wishlists     Wishlist[]

  @@map("products")
}

model ProductImage {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  product   Product @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productId String  @map("product_id") @db.ObjectId
  imageUrl  String  @map("image_url")
  altText   String? @map("alt_text")
  sortOrder Int     @default(0) @map("sort_order")

  @@map("product_images")
}

model ProductVariant {
  id              String      @id @default(auto()) @map("_id") @db.ObjectId
  product         Product     @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productId       String      @map("product_id") @db.ObjectId
  weightLabel     String      @map("weight_label")
  price           Float
  discountedPrice Float?      @map("discounted_price")
  stockQty        Int         @default(0) @map("stock_qty")
  sku             String      @unique
  cartItems       CartItem[]
  orderItems      OrderItem[]

  @@map("product_variants")
}

model Cart {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  user      User?      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId    String?    @map("user_id") @db.ObjectId
  sessionId String?    @map("session_id")
  createdAt DateTime   @default(now()) @map("created_at")
  items     CartItem[]

  @@map("carts")
}

model CartItem {
  id               String         @id @default(auto()) @map("_id") @db.ObjectId
  cart             Cart           @relation(fields: [cartId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cartId           String         @map("cart_id") @db.ObjectId
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productVariantId String         @map("product_variant_id") @db.ObjectId
  quantity         Int            @default(1)

  @@map("cart_items")
}

model Order {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  user          User?         @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId        String?       @map("user_id") @db.ObjectId
  orderNumber   String        @unique @map("order_number")
  status        String        @default("pending")
  subtotal      Float
  discount      Float         @default(0)
  deliveryFee   Float         @map("delivery_fee") @default(0)
  total         Float
  paymentStatus String        @default("pending") @map("payment_status")
  createdAt     DateTime      @default(now()) @map("created_at")
  items         OrderItem[]
  address       OrderAddress?
  payment       Payment?

  @@map("orders")
}

model OrderItem {
  id               String         @id @default(auto()) @map("_id") @db.ObjectId
  order            Order          @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orderId          String         @map("order_id") @db.ObjectId
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productVariantId String         @map("product_variant_id") @db.ObjectId
  quantity         Int
  priceAtPurchase  Float          @map("price_at_purchase")

  @@map("order_items")
}

model OrderAddress {
  id      String  @id @default(auto()) @map("_id") @db.ObjectId
  order   Order   @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orderId String  @unique @map("order_id") @db.ObjectId
  line1   String
  line2   String?
  city    String
  state   String
  pincode String

  @@map("order_addresses")
}

model Payment {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  order         Order    @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orderId       String   @unique @map("order_id") @db.ObjectId
  gateway       String
  transactionId String   @unique @map("transaction_id")
  amount        Float
  status        String
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("payments")
}

model Coupon {
  id                   String    @id @default(auto()) @map("_id") @db.ObjectId
  name                 String?
  code                 String    @unique
  discountType         String    @map("discount_type")
  discountValue        Float     @map("discount_value")
  minOrderValue        Float     @default(0) @map("min_order_value")
  maxOrderValue        Float?    @map("max_order_value")
  applicableCategories String?   @map("applicable_categories")
  festivalName         String?   @map("festival_name")
  startDate            DateTime? @map("start_date")
  endDate              DateTime? @map("end_date")
  expiryDate           DateTime? @map("expiry_date")
  usageLimit           Int?      @map("usage_limit")
  maxUsesPerUser       Int?      @default(1) @map("max_uses_per_user")
  timesUsed            Int       @default(0) @map("times_used")
  isActive             Boolean   @default(true) @map("is_active")
  createdAt            DateTime  @default(now()) @map("created_at")

  @@map("coupons")
}

model Review {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  product   Product  @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productId String   @map("product_id") @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId    String   @map("user_id") @db.ObjectId
  rating    Int
  comment   String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("reviews")
}

model Wishlist {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  user      User    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId    String  @map("user_id") @db.ObjectId
  product   Product @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productId String  @map("product_id") @db.ObjectId

  @@unique([userId, productId])
  @@map("wishlists")
}

model Store {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  address   String
  city      String
  pincode   String
  latitude  Float?
  longitude Float?
  phone     String

  @@map("store_outlets")
}

model BlogPost {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  slug        String    @unique
  content     String
  status      String    @default("published")
  author      String?   @default("Admin")
  category    String?   @default("General")
  imageUrl    String?   @map("image_url")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("blog_posts")
}
